{
  "name": "ticket-war-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop-assisted ticket purchasing automation",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "bot:simulator": "tsx simulator/server.ts",
    "inspect": "tsx src/inspect.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "playwright": "^1.58.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
